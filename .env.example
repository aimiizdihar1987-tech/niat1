# Copy to .env for local Docker testing. Never put real values in this file.
GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NIAT_AUTH_SECRET=

# Required for Agent 6 mail/submission checks through the Apps Script hub.
APPSCRIPT_HUB_URL=
APPSCRIPT_HUB_KEY=
TEACHER_EMAIL=jpn-perlis-cm16@moe-dl.edu.my
TEACHER_NAME=
NIAT_REQUIRE_HUB=1

# Required for Agent 4 automatic Forms/Classroom posting. Store each complete
# JSON document on one line when using an env file. In Cloud Run, use secrets.
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_OAUTH_CLIENT_JSON=
NIAT_REQUIRE_GOOGLE_OAUTH=1

# Required by the authenticated Cloud Scheduler reminder endpoint.
NIAT_CRON_SECRET=

# Deployment identity — surfaced on /api/status and the public /status.html page
# so the running instance can be matched to a commit and a host. Optional
# locally; CI/Cloud Build set NIAT_BUILD_SHA automatically.
NIAT_PUBLIC_URL=
NIAT_BUILD_SHA=
NIAT_BUILD_TIME=
NIAT_REGION=

# Observability: JSON logs (one object per line, for Cloud Logging) and level.
NIAT_JSON_LOGS=1
NIAT_LOG_LEVEL=info
