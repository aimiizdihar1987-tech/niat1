{
  "id": "NiatReminder0001",
  "name": "Niat Reminder",
  "nodes": [
    {
      "parameters": {
        "content": "## Niat Reminder (n8n version)\nMirrors reminder.py — same timetable.json + reminder_config.txt.\nEvery day 5:00 PM: if there are English classes tomorrow, send the teacher a reminder by Telegram, email (Apps Script webhook) and WhatsApp (CallMeBot, if activated).\n\nThe Python reminder task stays as backup — disable one of them once you trust this.",
        "height": 260,
        "width": 340
      },
      "id": "sticky-1",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-140, 20]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 17,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "trigger-1",
      "name": "Every day 5 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "fileSelector": "C:/Users/HP/Desktop/PRESTIJ KAK AIMI/timetable.json",
        "options": {}
      },
