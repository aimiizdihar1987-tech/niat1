        "fileSelector": "C:/Users/HP/Desktop/PRESTIJ KAK AIMI/reminder_config.txt",
        "options": {}
      },
      "id": "read-cfg",
      "name": "Read config",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 420]
    },
    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "extract-tt",
      "name": "Timetable as JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [440, 180]
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "id": "extract-cfg",
      "name": "Config as text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [440, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-1",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const ttJson = $('Timetable as JSON').first().json;\nconst item = (ttJson.data && typeof ttJson.data === 'object') ? ttJson.data : ttJson;\nconst cfgJson = $('Config as text').first().json;\nconst cfgText = (typeof cfgJson.data === 'string') ? cfgJson.data : '';\n\nconst cfg = {};\nfor (const line of cfgText.split(/\\r?\\n/)) {\n  const l = line.trim();\n  if (!l || l.startsWith('#') || !l.includes('=')) continue;\n  const i = l.indexOf('=');\n  cfg[l.slice(0, i).trim()] = l.slice(i + 1).trim();\n}\n\nconst tomorrow = $now.plus({ days: 1 });\nconst day = tomorrow.weekdayLong;\nconst dateStr = tomorrow.toFormat('dd LLL yyyy');\nconst iso = tomorrow.toFormat('yyyy-MM-dd');\n\nconst classes = (item.classes || []).filter(\n  c => (c.day || '').trim().toLowerCase() === day.toLowerCase()\n);\n\nconst host = cfg.REMINDER_HOST || 'localhost';\nconst base = `http://${host}:8050`;\n\nconst lines = [];\nconst linkLines = [];\nfor (const c of classes) {\n  let link = base;\n  if (c.class) {\n    link += '?class=' + encodeURIComponent(c.class) + '&date=' + iso;\n  }\n  const where = c.time ? `${c.class} at ${c.time}` : c.class;\n  lines.push(`- ${where}\\n  Prepare lesson plan -> ${link}`);\n  linkLines.push(`  - ${c.class} (${c.time || ''}) -> ${link}`);\n}\n\nconst teacher = item.teacher_name || 'Teacher';\nconst body =\n  `Hi ${teacher}!\\n\\n` +\n  `Tomorrow (${day}, ${dateStr}) you have an English class with:\\n` +\n  lines.join('\\n') +\n  '\\n\\nWould you like to prepare the lesson plan? Tap a link above to open Niat.';\nconst emailBody =\n  `Dear ${teacher},\\n\\n` +\n  `You have English class(es) tomorrow, ${day}, ${dateStr}:\\n\\n` +\n  linkLines.join('\\n') +\n  `\\n\\nWould you like to prepare tomorrow's lesson? Click a class above ` +\n  'to auto-generate the lesson plan (RPH) and worksheet in Niat.\\n\\n' +\n  'If your lessons are ready, please ignore this email.\\n\\n' +\n  'Thank you,\\nNiat - your AI teaching assistant';\n\nreturn [{\n  json: {\n    hasClasses: classes.length > 0,\n    classCount: classes.length,\n    subject: `Niat: prepare tomorrow's English lesson? (${day}, ${dateStr})`,\n    body,\n    emailBody,\n    to: cfg.TEACHER_EMAIL || '',\n    tgToken: cfg.TELEGRAM_BOT_TOKEN || '',\n    tgChat: cfg.TELEGRAM_CHAT_ID || '',\n    mailUrl: cfg.APPSCRIPT_MAIL_URL || '',\n    mailKey: cfg.APPSCRIPT_MAIL_KEY || '',\n    waPhone: (cfg.TEACHER_WHATSAPP || '').replace(/[+\\s]/g, ''),\n    waKey: cfg.CALLMEBOT_APIKEY || ''\n  }\n}];"
      },
      "id": "code-1",
      "name": "Compose reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
